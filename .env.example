# Copy to server/.env  (cp .env.example server/.env). Never commit real values.
DATABASE_URL="postgresql://jobboard:jobboard_dev@127.0.0.1:55432/jobboard"
# Used by the test runner; MUST be a different database from DATABASE_URL
TEST_DATABASE_URL="postgresql://jobboard:jobboard_dev@127.0.0.1:55432/jobboard_test"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
PORT=4000
# Browser origin allowed by CORS (the Vite dev server by default)
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development
# Private resume storage directory (outside any publicly served directory)
UPLOAD_DIR="./storage/resumes"
# Maximum resume size in bytes (5 MB)
MAX_UPLOAD_BYTES=5242880
